<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddNumbersActivity">

    <EditText
        android:id="@+id/familyNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Family Number"
        android:layout_margin="16dp"
        android:inputType="phone"/>

    <EditText
        android:id="@+id/helpNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Help Number"
        android:layout_margin="16dp"
        android:layout_below="@id/familyNumberInput"
        android:inputType="phone"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Numbers"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/helpNumberInput"
        android:layout_marginTop="16dp"/>
</RelativeLayout>
